DATABASE_URL=postgresql://dynamics:replace-me@127.0.0.1:5432/dynamics
# Instead of DATABASE_URL, deployments may set PGHOST, PGPORT, PGDATABASE,
# PGUSER, and PGPASSWORD separately. Compose uses separate variables so a
# database password never has to be URL-encoded into a connection string.
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=microsoft-dynamics-sales-core
JWT_AUDIENCE=microsoft-dynamics-sales-console
BACKEND_HOST=127.0.0.1
BACKEND_PORT=4001
ALLOWED_ORIGINS=http://127.0.0.1:3000
TRUST_PROXY=0
VITE_API_BASE_URL=
VITE_API_TARGET=http://127.0.0.1:4001

# One-time `npm run bootstrap` inputs; remove them after provisioning.
BOOTSTRAP_ACKNOWLEDGEMENT=create-initial-admin
BOOTSTRAP_TENANT_SLUG=replace-me
BOOTSTRAP_TENANT_NAME=Replace Me
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_NAME=Initial Administrator
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
